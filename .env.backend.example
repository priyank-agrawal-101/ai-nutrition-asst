# Railway backend only. Copy these names into Railway Variables, not Git.
APP_ENV=production
APP_ROLE=backend
APP_ORIGIN=https://YOUR-FRONTEND.vercel.app
PROVIDER_MODE=groq
GROQ_API_KEY=REPLACE_IN_RAILWAY
GROQ_DAILY_CALL_LIMIT=1000
GROQ_DAILY_TOKEN_LIMIT=200000
# Same dedicated PostgreSQL host/database, two different users.
MIGRATION_DATABASE_URL=postgresql://POSTGRES_OWNER:OWNER_PASSWORD@PRIVATE_HOST:5432/railway
DATABASE_URL=postgresql://nutribite_runtime:RANDOM_HEX_PASSWORD@PRIVATE_HOST:5432/railway
CSRF_KEYS={"v1":"REPLACE_WITH_32_RANDOM_BYTES_BASE64URL"}
CSRF_ACTIVE_KEY=v1
QUOTA_KEY=REPLACE_WITH_DIFFERENT_32_RANDOM_BYTES_BASE64URL
QUOTA_KEY_VERSION=v1
PROXY_SHARED_SECRET=REPLACE_WITH_THIRD_32_RANDOM_BYTES_BASE64URL
# Start disabled while configuring; enable for controlled live verification.
GENERATION_ENABLED=false
BUILD_ID=REPLACE_WITH_DEPLOYED_GIT_COMMIT
# Railway supplies PORT. Do not use the loopback local launcher here.
