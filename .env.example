# Local bootstrap generates ignored configuration; never use these placeholders as keys.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
PROVIDER_MODE=scripted
DATABASE_URL=postgresql://nutribite_runtime:REPLACE@127.0.0.1:5432/nutribite_local
MIGRATION_DATABASE_URL=postgresql://nutribite_migrator:REPLACE@127.0.0.1:5432/nutribite_local
CSRF_KEYS={"v1":"REPLACE_WITH_32_RANDOM_BYTES_BASE64URL"}
CSRF_ACTIVE_KEY=v1
QUOTA_KEY=REPLACE_WITH_DIFFERENT_32_RANDOM_BYTES_BASE64URL
QUOTA_KEY_VERSION=v1
GENERATION_ENABLED=true
BUILD_ID=local-uncommitted
# Tests require a dedicated bootstrap cluster; scripts/test.mjs provisions one if omitted.
# TEST_DATABASE_URL=postgresql://test_admin:REPLACE@127.0.0.1:5432/postgres
