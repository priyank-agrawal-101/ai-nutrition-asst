# Vercel production environment only. No backend/provider/database credentials.
APP_ENV=production
APP_ROLE=frontend
APP_ORIGIN=https://YOUR-FRONTEND.vercel.app
BACKEND_ORIGIN=https://YOUR-BACKEND.up.railway.app
PROXY_SHARED_SECRET=EXACT_SAME_VALUE_AS_RAILWAY
# Vercel supplies VERCEL and VERCEL_ENV. Do not set or fake them manually.
# Do not apply these production secrets to Preview or Development environments.
